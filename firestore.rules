rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() {
      return myRole() == 'admin';
    }
    function isMiniAdmin() {
      return myRole() == 'miniadmin';
    }
    function isProfessor() {
      return myRole() == 'professor';
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        || isAdmin()
        || (isMiniAdmin() && request.resource.data.role in ['aluno', 'professor']);

      allow update: if isOwner(userId)
        || isAdmin()
        || (isMiniAdmin() &&
            resource.data.role in ['aluno', 'professor'] &&
            request.resource.data.role in ['aluno', 'professor']);

      allow delete: if isAdmin()
        || (isMiniAdmin() && resource.data.role in ['aluno', 'professor']);
    }

    match /materias/{materiaId} {
      allow read: if isSignedIn();
      allow write: if isProfessor() || isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    match /studentStats/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /contacts/{contactId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
  }
}
